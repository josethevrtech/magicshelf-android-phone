{
  "controller_type": "frame_controller",
  "name": "Android Phone (Virtual)",
  "description": "Point at the screen: stick scrolls; hold stick and move up/down to pinch; trigger or A/X taps. B goes back; Y opens Home. Grip picks up; holding-hand stick+press changes depth; free-hand stick still scrolls.",
  "bindings": {
    "/actions/phone": {
      "sources": [
        {
          "path": "/user/hand/left/input/thumbstick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/phone/in/scroll"
            },
            "click": {
              "output": "/actions/phone/in/pinch"
            }
          }
        },
        {
          "path": "/user/hand/right/input/thumbstick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/phone/in/scroll"
            },
            "click": {
              "output": "/actions/phone/in/pinch"
            }
          }
        },
        {
          "path": "/user/hand/right/input/a",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/phone/in/click"
            }
          }
        },
        {
          "path": "/user/hand/right/input/b",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/phone/in/back"
            }
          }
        },
        {
          "path": "/user/hand/left/input/y",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/phone/in/home"
            }
          }
        },
        {
          "path": "/user/hand/left/input/grip",
          "mode": "trigger",
          "inputs": {
            "click": {
              "output": "/actions/phone/in/grip"
            }
          }
        },
        {
          "path": "/user/hand/right/input/grip",
          "mode": "trigger",
          "inputs": {
            "click": {
              "output": "/actions/phone/in/grip"
            }
          }
        },
        {
          "path": "/user/hand/left/input/x",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/phone/in/click"
            }
          }
        }
      ]
    }
  }
}
